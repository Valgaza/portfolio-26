# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# ── Required for the AI chat (/api/chat) ──────────────────────────────────────
# OpenAI API key — powers the portfolio chatbot (gpt-4o-mini).
# Get one at https://platform.openai.com/api-keys. Put the REAL value in
# `.env.local` (gitignored), NEVER here. Without it, the chat returns a 503 and
# the drawer shows a friendly "not configured yet" message.
OPENAI_API_KEY=

# ── Optional: rate limiting for the chat (recommended in production) ──────────
# Upstash Redis (https://console.upstash.com/). If BOTH are set, the /api/chat
# route limits each IP to 20 messages/hour. If unset, rate limiting is skipped
# (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
