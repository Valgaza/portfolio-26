# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.motiscope
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# study-only reference clone (not part of our build)
/reference

# motiscope screen recordings (large binaries — keep out of git)
/animations

# motiscope analysis output (curated frames + reports)
/.motiscope

# Local AI / editor config
/.claude

# Agent build-notes — local only, not part of the public repo
/AGENTS.md
/CLAUDE.md

# Display font (Kovanov) — "Free for Personal Use", NOT redistributable, so it
# is kept OUT of the public repo. Download it and drop the files in content/.
# See README ("Fonts"). The licence text itself (exFont-License.txt) stays.
content/*.otf
content/*.ttf
content/readme.html

# Real AI system prompt — personal content, kept out of the public repo.
# Copy knowledge.example.ts → knowledge.ts and fill it in. See README.
src/lib/chat/knowledge.ts
